{
  "name": "llm-gateway-monorepo",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev:web": "pnpm --filter @llm-gateway/web dev",
    "build:web": "pnpm --filter @llm-gateway/web build",
    "test:web": "pnpm --filter @llm-gateway/web test",
    "typecheck:web": "pnpm --filter @llm-gateway/web typecheck",
    "contracts": "pnpm --filter @llm-gateway/web contracts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
